{
    "name" : "dev-container",
    "build" : {
        "dockerfile": "../docker/dev-container.Dockerfile"
    },

    "image": "market-mon-dev:latest",
    "runArgs": [
        "--name", "market-mon-dev",
        "--rm",
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined"
    ],

    "features": {
        "ghcr.io/devcontainers/features/common-utils:2.5.8": {
            "installZsh": true,
            "configureZshAsDefaultShell": true,
            "installOhMyZsh": true,
            "username": "ubuntu"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "pbkit.vscode-pbkit",
                "kylinideteam.cmake-intellisence"],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            }
        }
    },
    "remoteUser": "ubuntu",
    "updateRemoteUserUID": true,
    "workspaceFolder": "/work",
    "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",

    "mounts": [
        "source=market-mon-zsh-history,target=/home/ubuntu/.zsh_history_dir,type=volume"
    ],

    "postCreateCommand": [
        "sh",
        "-c",
        "git clone https://github.com/zsh-users/zsh-autosuggestions.git ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions || true",
        "git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ~/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting || true",
        "sed -i 's/plugins=(git)/plugins=(git zsh-autosuggestions zsh-syntax-highlighting)/' ~/.zshrc",
        "echo 'HISTFILE=~/.zsh_history_dir/.zsh_history' >> ~/.zshrc"]


}
